class Строительный_Инструмент:
    """
    Базовый класс для строительных инструментов.

    Атрибуты:
        название (str): Название инструмента.
        мощность (int): Мощность инструмента в ваттах.
        _серийный_номер (str): Серийный номер инструмента (инкапсулирован).
    """

    def __init__(self, название: str, мощность: int, серийный_номер: str) -> None:
        """
        Конструктор базового класса.

        Аргументы:
            название (str): Название инструмента.
            мощность (int): Мощность инструмента в ваттах.
            серийный_номер (str): Серийный номер инструмента.
        """
        self.название = название
        self.мощность = мощность
        self._серийный_номер = серийный_номер  # Инкапсулированный атрибут

    def __str__(self) -> str:
        """
        Возвращает строковое представление инструмента.

        Возвращает:
            str: Строка с описанием инструмента.
        """
        return f"{self.название} (мощность: {self.мощность} Вт)"

    def __repr__(self) -> str:
        """
        Возвращает формальное строковое представление инструмента.

        Возвращает:
            str: Формальное описание инструмента.
        """
        return f"СтроительныйИнструмент(название={self.название}, мощность={self.мощность})"

    def получить_серийный_номер(self) -> str:
        """
        Возвращает серийный номер инструмента.

        Возвращает:
            str: Серийный номер инструмента.
        """
        return self._серийный_номер

    def включить(self) -> str:
        """
        Включает инструмент.

        Возвращает:
            str: Сообщение о включении инструмента.
        """
        return f"{self.название} включен."


class Дрель(Строительный_Инструмент):
    """
    Дочерний класс для дрели.

    Атрибуты:
        название (str): Название дрели.
        мощность (int): Мощность дрели в ваттах.
        серийный_номер (str): Серийный номер дрели.
        количество_режимов (int): Количество режимов работы дрели.
    """

    def __init__(self, название: str, мощность: int, серийный_номер: str, количество_режимов: int) -> None:
        """
        Конструктор дочернего класса.

        Аргументы:
            название (str): Название дрели.
            мощность (int): Мощность дрели в ваттах.
            серийный_номер (str): Серийный номер дрели.
            количество_режимов (int): Количество режимов работы дрели.
        """
        super().__init__(название, мощность, серийный_номер)
        self.количество_режимов = количество_режимов

    def __str__(self) -> str:
        """
        Возвращает строковое представление дрели.

        Возвращает:
            str: Строка с описанием дрели.
        """
        return f"{self.название} (мощность: {self.мощность} Вт, режимов: {self.количество_режимов})"

    def __repr__(self) -> str:
        """
        Возвращает формальное строковое представление дрели.

        Возвращает:
            str: Формальное описание дрели.
        """
        return f"Дрель(название={self.название}, мощность={self.мощность}, режимов={self.количество_режимов})"

    def включить(self, режим: int = 1) -> str:
        """
        Включает дрель в указанном режиме.

        Аргументы:
            режим (int): Режим работы дрели (по умолчанию 1).

        Возвращает:
            str: Сообщение о включении дрели в указанном режиме.

        Примечание:
            Метод перегружен, чтобы добавить возможность выбора режима работы.
        """
        if режим < 1 or режим > self.количество_режимов:
            return f"Ошибка: режим {режим} недоступен."
        return f"{self.название} включен в режиме {режим}."
        